			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.125rem"
					}
				},
				{
					"name": "X Large",
					"slug": "x-large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "Heading",
					"slug": "heading",
					"size": "1.625rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.625rem"
					}
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "2.875rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.875rem"
					}
				},
				{
					"name": "Colossal",
					"slug": "colossal",
					"size": "3.125rem",
					"fluid": {
						"min": "1.875rem",
						"max": "3.125rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "20",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "30",
					"slug": "30",
					"size": "1rem"
				},
				{
					"name": "40",
					"slug": "40",
					"size": "1.5rem"
				},
				{
					"name": "50",
					"slug": "50",
					"size": "clamp(2rem, 4vw, 2.5rem)"
				},
				{
					"name": "60",
					"slug": "60",
					"size": "clamp(2.5rem, 6vw, 4rem)"
				},
				{
					"name": "70",
					"slug": "70",
					"size": "clamp(3rem, 6vw, 5.3125rem)"
				},
				{
					"name": "80",
					"slug": "80",
					"size": "clamp(3.75rem, 10.5vw, 9.375rem)"
				},
				{
					"name": "90",
					"slug": "90",
					"size": "clamp(3.75rem, 14vw, 12.5rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 10px 20px rgba(160, 160, 160, 0.18)"
				},
				{
					"name": "Lifted",
					"slug": "lifted",
					"shadow": "0 16px 36px rgba(0, 0, 0, 0.14)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--muted)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)",
				"top": "0px",
				"bottom": "0px"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "600",
					"lineHeight": "1.26"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--colossal)",
					"fontWeight": "500",
					"lineHeight": "1.24"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading)",
					"fontWeight": "500"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "500"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "500"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-deep)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"typography": {
					"fontFamily": "inherit",
					"fontWeight": "400",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				},
				"border": {
					"radius": "30px",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": {
						"top": "1.0625rem",
						"bottom": "1.0625rem",
						"left": "3.25rem",
						"right": "3.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-deep)",
						"text": "var(--wp--preset--color--on-primary)"
					},
					"border": {
						"color": "var(--wp--preset--color--primary-deep)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--divider)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "400"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
