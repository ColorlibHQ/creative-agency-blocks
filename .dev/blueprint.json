{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Creative Agency",
        "blogdescription": "Design and development studio"
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "creative-agency"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/themes/creative-agency/.dev/demo/import.php';"
    },
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    }
  ]
}
